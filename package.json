{
  "name": "estates-general",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "sim": "pnpm --filter @estates/sim start --",
    "serve": "pnpm --filter @estates/server start",
    "build": "pnpm --filter @estates/web build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
